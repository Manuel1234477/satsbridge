# Copy to .env and fill in. Never commit .env.
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=sqlite://satsbridge-stellar.db
RUST_LOG=satsbridge=debug,tower_http=info

# Public https origin of this server (no trailing slash). Default base for BITNOB_CALLBACK_URL.
PUBLIC_BASE_URL=
# Origins allowed to call the API from a browser (the frontend), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Use X-Forwarded-For for client IPs. Only behind a proxy you control.
TRUST_PROXY_HEADERS=false

# Bearer token for /api/v1/admin/* (ops dashboard). Admin routes are disabled when empty.
ADMIN_API_KEY=
# Requests per minute per user (and per IP on public routes); new users per hour per IP. 0 = off.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_SIGNUPS_PER_HOUR=20

# HMAC-SHA256 secret for /api/v1/webhooks/provider and /api/v1/webhooks/collections
# (header: X-SatsBridge-Signature: <hex>).
PROVIDER_WEBHOOK_SECRET=change-me-provider

QUOTE_TTL_SECS=120
# Fee in basis points of the amount sent, plus a flat fee in source minor units (kobo).
FEE_BPS=100
FLAT_FEE_MINOR=0
# Held back from the DEX estimate so the quoted payout survives small price moves. The quoted
# payout is the Stellar path payment's destMin: delivered in full, or the settlement fails and
# the sender is refunded.
SLIPPAGE_BPS=50

# --- Stellar (settlement) ---
# testnet (default) or simulated (in-memory, nothing reaches Stellar; for offline demos).
STELLAR_LEDGER=testnet
# Create these with `cargo run --bin stellar_setup`, which funds the accounts with friendbot,
# adds trustlines, mints market maker inventory and places DEX offers, then prints the keys.
# Testnet keys only. Testnet resets every few months: rerun stellar_setup afterwards.
STELLAR_ISSUER_SECRET=
STELLAR_TREASURY_SECRET=
# Used only by stellar_setup (the API never touches the market maker).
STELLAR_MARKET_MAKER_SECRET=
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Token every path routes through.
STELLAR_BRIDGE_ASSET=USD
# How long a signed transaction stays valid. One that never made it is rebuilt after this.
STELLAR_TX_TIMEOUT_SECS=60
STELLAR_EXPLORER_URL=https://stellar.expert/explorer/testnet
# Simulated ledger only: DEX spread per hop.
SIMULATED_SPREAD_BPS=30
# stellar_setup only: market maker spread per side, and offer size per side in USD.
MM_SPREAD_BPS=30
MM_DEPTH_USD=250000

# --- Collections (how the sender pays in) ---
# Mock NGN virtual-account rail: each payment gets its own account number, and deposits are
# reported on /api/v1/webhooks/collections (or simulated with the dev route).
MOCK_COLLECTIONS=true
# Max single NGN deposit, in kobo (₦5,000,000).
NGN_MAX_DEPOSIT_MINOR=500000000
# How long the sender has to make the transfer.
DEPOSIT_EXPIRY_SECS=1800

# --- Payouts ---
# Bitnob corridors to enable: NG = Naira bank transfer (used for refunds); KE, CI, SN, NE, CM, GH,
# ... = mobile money. Empty disables Bitnob. Each country is checked against Bitnob at startup.
BITNOB_COUNTRIES=
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
BITNOB_WEBHOOK_SECRET=
# Defaults to PUBLIC_BASE_URL/api/v1/webhooks/bitnob. Must be reachable from the internet.
BITNOB_CALLBACK_URL=
# Bitnob balance payouts are debited from (BTC, USDT or USDC). Fund it from the treasury.
BITNOB_FROM_ASSET=USDC
# Override the Bitnob host, e.g. the local stand-in (`cargo run --bin bitnob_sandbox`).
BITNOB_BASE_URL=
# Mock rails (NGN bank, Tando KES, XOF/XAF/GNF/GHS mobile money) wherever no real provider serves
# a currency and rail. Set false in production.
MOCK_PAYOUTS=true
# Max single payout on the mock NGN rail (refunds), in kobo (₦500,000).
NGN_MAX_PAYOUT_MINOR=50000000

# --- Recovery worker ---
# Interval; 0 disables it. Also expires unpaid payments and confirms Stellar transactions.
RECOVERY_POLL_SECS=10
# Attempts before a payout goes to manual review on the ops dashboard.
PAYOUT_MAX_ATTEMPTS=5
# First retry delay, doubling per attempt. Keep it above the longest provider call (~45 s).
PAYOUT_RETRY_BACKOFF_SECS=120
# Ask the provider about accepted payouts with no webhook after this long.
PAYOUT_UNCONFIRMED_AFTER_SECS=600
# Look up Stellar transactions with no recorded outcome after this long.
STELLAR_CONFIRM_AFTER_SECS=15

# --- Reference FX (units per USD) ---
# Prices the market maker's offers (stellar_setup) and the simulated ledger. Quotes themselves
# come from the Stellar DEX. Tried in order per currency: coinbase, coingecko, static.
FX_PROVIDERS=coinbase,coingecko,static
FX_CACHE_TTL_SECS=60
FX_MAX_AGE_SECS=600
FX_HTTP_TIMEOUT_MS=2000
# Optional CoinGecko demo-plan key (sent as x-cg-demo-api-key).
COINGECKO_API_KEY=
FX_STATIC_RATES=NGN=1550,KES=129,GHS=15.4,XOF=603.5,XAF=603.5,GNF=8650

# Enables /api/v1/dev/payments/{id}/{deposit,payout,refund}, which simulate the *mock*
# providers' callbacks only. Stellar settlement is never simulated by these. Never in production.
DEV_ROUTES=true
