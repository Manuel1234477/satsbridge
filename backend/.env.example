# Copy to .env and fill in. Never commit .env.
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=sqlite://satsbridge.db
RUST_LOG=satsbridge=debug,tower_http=info

# Optional bearer token for the protected /api/v1 routes. Leave empty to disable auth (local demo only).
API_KEY=

# HMAC-SHA256 secret for /api/v1/webhooks/provider (header: X-SatsBridge-Signature: <hex>).
PROVIDER_WEBHOOK_SECRET=change-me-provider

QUOTE_TTL_SECS=120
INVOICE_EXPIRY_SECS=600
FEE_BPS=100
FLAT_FEE_SATS=0

# BTC price feeds, tried in order per currency. Options: coinbase, coingecko, static.
# Coinbase covers all five currencies; CoinGecko has no GNF. XOF/XAF are always derived from BTC/EUR x 655.957.
# Add ",static" only for offline demos: static prices are never updated.
FX_PROVIDERS=coinbase,coingecko
FX_CACHE_TTL_SECS=30
FX_MAX_AGE_SECS=300
FX_HTTP_TIMEOUT_MS=2000
# Optional CoinGecko demo-plan key (sent as x-cg-demo-api-key).
COINGECKO_API_KEY=
# Used only by the static provider (major units per 1 BTC).
FX_STATIC_PRICES=XOF=48300000,XAF=48300000,GNF=730000000,KES=10700000,NGN=110000000

# Max single NGN payout in kobo (default ₦500,000).
NGN_MAX_PAYOUT_MINOR=50000000

# Lightning node (required). SatsBridge checks these keys at startup and refuses to start if they fail.
LNBITS_URL=https://your-lnbits-host
# Invoice/read key: receives sender payments.
LNBITS_INVOICE_KEY=
# Admin/spend key: only needed to pay Tapnob Lightning Addresses. Keep the wallet balance small.
LNBITS_ADMIN_KEY=
# Optional public URL of /api/v1/webhooks/lnbits. LNbits only accepts domain names by default
# (not IPs or localhost); if it rejects this URL, invoices are created without it and the
# settlement watcher below still settles them.
LNBITS_WEBHOOK_URL=
# Seconds between settlement checks for unpaid invoices (also expires them). 0 disables.
LIGHTNING_POLL_SECS=5

# NGN bank payouts: mock (offline demo) or bitnob.
NGN_BANK_PROVIDER=mock
# Bitnob (https://api.bitnob.com). Sandbox vs production is selected by which secret you use.
# Payouts debit your Bitnob balance in BITNOB_FROM_ASSET, so pre-fund it.
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
BITNOB_WEBHOOK_SECRET=
# Public URL Bitnob calls with payout status (this server's /api/v1/webhooks/bitnob).
BITNOB_CALLBACK_URL=https://your-public-host/api/v1/webhooks/bitnob
BITNOB_FROM_ASSET=BTC
# Bitnob's NGN minimum is ₦500.
BITNOB_NGN_MIN_PAYOUT_MINOR=50000

# Tapnob Lightning Address rail for NGN (name@tapnob.io). Empty disables it.
# Paying needs LNBITS_ADMIN_KEY and sats in the LNbits wallet.
TAPNOB_DOMAINS=tapnob.io

# Enables /api/v1/dev/payments/{id}/payout, which simulates callbacks from the *mock* payout
# providers only. Lightning settlement can't be simulated. Never enable in production.
DEV_ROUTES=true
