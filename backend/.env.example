# Copy to .env and fill in. Never commit .env.
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=sqlite://satsbridge.db
RUST_LOG=satsbridge=debug,tower_http=info

# Public https origin of this server (no trailing slash), e.g. https://pay.example.com or a tunnel
# URL. Enables LNURL-pay, and is the default base for LNBITS_WEBHOOK_URL and BITNOB_CALLBACK_URL.
PUBLIC_BASE_URL=
# Origins allowed to call the API from a browser (the frontend), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Use X-Forwarded-For for client IPs. Only behind a proxy you control.
TRUST_PROXY_HEADERS=false

# Bearer token for /api/v1/admin/* (ops dashboard). Admin routes are disabled when empty.
ADMIN_API_KEY=
# Requests per minute per user (and per IP on public routes); new users per hour per IP. 0 = off.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_SIGNUPS_PER_HOUR=20

# HMAC-SHA256 secret for /api/v1/webhooks/provider (header: X-SatsBridge-Signature: <hex>).
PROVIDER_WEBHOOK_SECRET=change-me-provider

QUOTE_TTL_SECS=120
INVOICE_EXPIRY_SECS=600
FEE_BPS=100
FLAT_FEE_SATS=0

# --- Lightning (required) ---
# SatsBridge checks these keys at startup and refuses to start if they fail.
LNBITS_URL=https://your-lnbits-host
# No node yet? Run `cargo run --bin lnbits_sandbox` (a local stand-in), then use
# LNBITS_URL=http://127.0.0.1:5000, LNBITS_INVOICE_KEY=sandbox-invoice-key and
# LNBITS_ADMIN_KEY=sandbox-admin-key. Invoices are paid on http://127.0.0.1:5000/sandbox.
# Invoice/read key: receives sender payments.
LNBITS_INVOICE_KEY=
# Admin/spend key: needed for Tapnob payouts and refunds. Keep the wallet balance small.
LNBITS_ADMIN_KEY=
# Defaults to PUBLIC_BASE_URL/api/v1/webhooks/lnbits. LNbits only accepts domain names by default;
# if it rejects the URL, invoices are created without it and the watcher below still settles them.
LNBITS_WEBHOOK_URL=
# Seconds between settlement checks for unpaid invoices (also expires them). 0 needs a webhook URL.
LIGHTNING_POLL_SECS=5

# --- Payouts ---
# Bitnob corridors to enable: NG = Naira bank transfer; KE, CI, SN, NE, CM, GA, ... = mobile money.
# Empty disables Bitnob. Each country is checked against Bitnob at startup (limits and fields).
BITNOB_COUNTRIES=
# Bitnob (https://api.bitnob.com). Sandbox vs production is selected by which secret you use.
# Payouts debit your Bitnob balance in BITNOB_FROM_ASSET, so pre-fund it.
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
BITNOB_WEBHOOK_SECRET=
# Defaults to PUBLIC_BASE_URL/api/v1/webhooks/bitnob. Must be reachable from the internet.
BITNOB_CALLBACK_URL=
BITNOB_FROM_ASSET=BTC
# Override the Bitnob host. Leave empty for api.bitnob.com. To try the Bitnob flow without an
# account, run `cargo run --bin bitnob_sandbox`, set this to http://127.0.0.1:9100 and use the
# same BITNOB_CLIENT_ID/SECRET/WEBHOOK_SECRET values for both programs. The stand-in also reads:
#   SANDBOX_BIND=127.0.0.1:9100  SANDBOX_AUTO_COMPLETE_SECS=3  SANDBOX_BALANCE_SATS=10000000
# An account number ending in 9999 makes a stand-in payout expire (exercises refunds).
BITNOB_BASE_URL=
# Mock rails (NGN bank, Tando KES, XOF/XAF mobile money) wherever no real provider serves a
# currency and rail. Set false in production.
MOCK_PAYOUTS=true
# Max single payout on the mock NGN rail, in kobo (₦500,000).
NGN_MAX_PAYOUT_MINOR=50000000
# Tapnob Lightning Address rail for NGN (name@tapnob.io). Empty disables it.
# Paying needs LNBITS_ADMIN_KEY and sats in the LNbits wallet.
TAPNOB_DOMAINS=tapnob.io

# --- Payout recovery ---
# Worker interval; 0 disables it.
RECOVERY_POLL_SECS=30
# Attempts before a payout goes to manual review on the ops dashboard.
PAYOUT_MAX_ATTEMPTS=5
# First retry delay, doubling per attempt. Keep it above the longest provider call (~45 s).
PAYOUT_RETRY_BACKOFF_SECS=120
# Ask the provider about accepted payouts with no webhook after this long.
PAYOUT_UNCONFIRMED_AFTER_SECS=600

# --- FX ---
# BTC price feeds, tried in order per currency: bitnob, coinbase, coingecko, static.
# Default: bitnob,coinbase,coingecko when BITNOB_COUNTRIES is set (so quotes use the rate Bitnob
# pays out at), otherwise coinbase,coingecko. Coinbase covers all five currencies; CoinGecko has
# no GNF. XOF/XAF are always derived from BTC/EUR x 655.957. Add ",static" only for offline demos.
FX_PROVIDERS=
FX_CACHE_TTL_SECS=30
# Each Bitnob refresh creates throwaway payout quotes, so it refreshes less often.
FX_BITNOB_TTL_SECS=60
FX_MAX_AGE_SECS=300
FX_HTTP_TIMEOUT_MS=2000
# Optional CoinGecko demo-plan key (sent as x-cg-demo-api-key).
COINGECKO_API_KEY=
# Used only by the static provider (major units per 1 BTC).
FX_STATIC_PRICES=XOF=48300000,XAF=48300000,GNF=730000000,KES=10700000,NGN=110000000

# Enables /api/v1/dev/payments/{id}/payout, which simulates callbacks from the *mock* payout
# providers only. Lightning settlement can't be simulated. Never enable in production.
DEV_ROUTES=true
