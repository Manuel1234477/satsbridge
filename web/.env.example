# Backend API (run `cargo run` in backend/ to serve on :8080)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Show the dev-only "simulate payout" panel (mock payout provider only)
NEXT_PUBLIC_DEV_TOOLS=false

# Use the in-browser mock API instead of the backend (works with no backend or LNbits)
NEXT_PUBLIC_MOCK_API=false

# Mock only: multiply mock payment timings. 0.2 makes the demo five times faster.
NEXT_PUBLIC_MOCK_TIME_SCALE=1
